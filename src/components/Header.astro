---
import { Image } from 'astro:assets';
import HeaderLink from './HeaderLink.astro';
import logoImg from '../assets/logo nama.png';
---

<header class="header-wrapper">
  <nav class="floating-nav">
    <div class="nav-left">
      <h2>
        <a href="/" id="logo-refresh" title="TemanKita University Expo">
          <Image src={logoImg} alt="TemanKita University Expo" class="header-logo" />
        </a>
      </h2>
    </div>

    <div class="internal-links">
      <HeaderLink href="/">Home Page</HeaderLink>
      <HeaderLink href="/programs">Programs</HeaderLink>
      <HeaderLink href="/about">About Us</HeaderLink>
      <HeaderLink href="/store">Store</HeaderLink>
    </div>

    <div class="auth-links">
      <div class="guest-auth-row" id="guest-auth-row">
        <a href="/login" class="btn-login">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="login-icon">
            <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
          </svg>
          <span>Login</span>
        </a>
        <a href="/daftar" class="btn-daftar">
          <span>Daftar Sekarang</span>
        </a>
      </div>

      <div class="logged-auth-dropdown hidden" id="logged-auth-row">
        <button type="button" class="btn-profile-badge" id="btn-profile-toggle">
          <div class="user-avatar-circle">
            <span id="user-initial">S</span>
          </div>
          <span class="user-display-name" id="user-display-name">SobatKita</span>
          <svg viewBox="0 0 20 20" fill="currentColor" class="chevron-user-icon">
            <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
          </svg>
        </button>

        <div class="profile-dropdown-menu" id="profile-menu">
          <!-- Opsi 1: Dasbor Akun -->
          <a href="/dasbor" class="profile-menu-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="menu-svg">
              <rect width="7" height="9" x="3" y="3" rx="1"></rect>
              <rect width="7" height="5" x="14" y="3" rx="1"></rect>
              <rect width="7" height="9" x="14" y="12" rx="1"></rect>
              <rect width="7" height="5" x="3" y="16" rx="1"></rect>
            </svg>
            <span>Dasbor Akun</span>
          </a>

          <!-- Opsi 2: Ganti Password Langsung Ke Tab Dasbor -->
          <a href="/dasbor#tab-password" class="profile-menu-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="menu-svg">
              <rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
            <span>Ganti Password</span>
          </a>

          <div class="menu-divider"></div>

          <!-- Opsi 3: Keluar Tanpa Verifikasi -->
          <button type="button" class="profile-menu-item item-logout" id="menu-logout-btn">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="menu-svg">
              <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
              <polyline points="16 17 21 12 16 7"></polyline>
              <line x1="21" y1="12" x2="9" y2="12"></line>
            </svg>
            <span>Keluar</span>
          </button>
        </div>
      </div>
    </div>
  </nav>
</header>

<script>
  const guestRow = document.getElementById('guest-auth-row');
  const loggedRow = document.getElementById('logged-auth-row');
  const userInitial = document.getElementById('user-initial');
  const userDisplayName = document.getElementById('user-display-name');

  const profileToggle = document.getElementById('btn-profile-toggle');
  const profileMenu = document.getElementById('profile-menu');
  const logoutBtn = document.getElementById('menu-logout-btn');

  const loggedUser = localStorage.getItem('unix_logged_in_user');
  const userName = localStorage.getItem('unix_user_name') || 'SobatKita';

  if (loggedUser) {
    guestRow?.classList.add('hidden');
    loggedRow?.classList.remove('hidden');
    if (userDisplayName) userDisplayName.textContent = userName;
    if (userInitial) userInitial.textContent = userName.charAt(0).toUpperCase();
  } else {
    guestRow?.classList.remove('hidden');
    loggedRow?.classList.add('hidden');
  }

  profileToggle?.addEventListener('click', (e) => {
    e.stopPropagation();
    profileMenu?.classList.toggle('active');
  });

  window.addEventListener('click', () => {
    profileMenu?.classList.remove('active');
  });

  // Logout langsung keluar tanpa verifikasi
  logoutBtn?.addEventListener('click', () => {
    localStorage.removeItem('unix_logged_in_user');
    localStorage.removeItem('unix_user_name');
    localStorage.removeItem('unix_user_email');
    localStorage.removeItem('unix_user_phone');
    window.location.href = '/';
  });
</script>

<style>
  .hidden {
    display: none !important;
  }

  .header-wrapper,
  .floating-nav,
  .floating-nav * {
    font-family: 'Plus Jakarta Sans', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif !important;
  }

  .header-wrapper {
    position: fixed;
    top: 1rem;
    left: 0;
    right: 0;
    z-index: 100;
    display: flex;
    justify-content: center;
    padding: 0 1.25rem;
    pointer-events: none;
  }

  .floating-nav {
    pointer-events: auto;
    width: 100%;
    max-width: 1320px;
    min-height: 58px;
    padding: 0.45rem 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(14px);
    border-radius: 18px;
    border: 1px solid rgba(255, 255, 255, 0.6);
    box-shadow: 0 10px 30px -5px rgba(0, 0, 0, 0.08);
    box-sizing: border-box;
  }

  .nav-left {
    flex: 1;
    display: flex;
    align-items: center;
  }

  .header-logo {
    height: 40px;
    width: auto;
    object-fit: contain;
    display: block;
  }

  .internal-links {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  :global(.internal-links a) {
    color: #1e293b !important;
    font-size: 0.925rem !important;
    font-weight: 600 !important;
    text-decoration: none;
    padding: 0.5rem 0.85rem;
    border-radius: 8px;
  }

  .auth-links {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: flex-end;
  }

  .guest-auth-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .btn-login {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.5rem 1.15rem;
    border: 1px solid #cbd5e1;
    border-radius: 10px;
    color: #334155;
    background: rgba(255, 255, 255, 0.6);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .login-icon {
    width: 16px;
    height: 16px;
  }

  .btn-daftar {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 1.3rem;
    border-radius: 10px;
    background: #0284c7;
    border: 1px solid #0284c7;
    color: #ffffff;
    font-size: 0.9rem;
    font-weight: 700;
    text-decoration: none;
  }

  .logged-auth-dropdown {
    position: relative;
  }

  .btn-profile-badge {
    background: #f8fafc;
    border: 1.5px solid #e2e8f0;
    border-radius: 999px;
    padding: 0.35rem 0.95rem 0.35rem 0.45rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    cursor: pointer;
  }

  .user-avatar-circle {
    width: 30px;
    height: 30px;
    background: #0284c7;
    color: #ffffff;
    font-weight: 800;
    font-size: 0.85rem;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .user-display-name {
    font-size: 0.88rem;
    font-weight: 700;
    color: #1e293b;
    max-width: 130px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .chevron-user-icon {
    width: 16px;
    height: 16px;
    color: #64748b;
  }

  .profile-dropdown-menu {
    position: absolute;
    top: calc(100% + 10px);
    right: 0;
    width: 200px;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.12);
    padding: 0.5rem 0;
    display: none;
    z-index: 200;
  }

  .profile-dropdown-menu.active {
    display: block;
  }

  .profile-menu-item {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.65rem 1.15rem;
    font-size: 0.88rem;
    font-weight: 600;
    color: #334155;
    text-decoration: none;
    background: none;
    border: none;
    width: 100%;
    text-align: left;
    cursor: pointer;
    box-sizing: border-box;
  }

  .profile-menu-item:hover {
    background-color: #f1f5f9;
    color: #0284c7;
  }

  .menu-svg {
    width: 16px;
    height: 16px;
    color: #64748b;
  }

  .menu-divider {
    height: 1px;
    background: #e2e8f0;
    margin: 0.4rem 0;
  }

  .item-logout {
    color: #ef4444 !important;
  }

  .item-logout .menu-svg {
    color: #ef4444 !important;
  }
</style>