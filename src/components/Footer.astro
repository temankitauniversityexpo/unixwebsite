---
import { Image } from 'astro:assets';
// ==========================================
// 1. IMPORT ASSET LOGO
// ==========================================
import logoImg from '../assets/logo nama.png';

const today = new Date();

// ==========================================
// 2. DATA PROGRAM KEGIATAN (8 ITEM -> 2 KOLOM)
// ==========================================
const programLinks = [
  { name: 'Dare Series', href: '/programs' },
  { name: 'Talk Show', href: '/programs' },
  { name: 'Campus Fair', href: '/programs' },
  { name: 'Scholarship Fair', href: '/programs' },
  { name: 'Mentoring', href: '/programs' },
  { name: 'Try Out', href: '/programs' },
  { name: 'Tes Minat Bakat', href: '/programs' },
  { name: 'Focus Group Discussion', href: '/programs#fgd' },
];

// ==========================================
// 3. DATA MENU BAR (6 ITEM -> 2 KOLOM)
// ==========================================
const menuBarLinks = [
  { name: 'UNIX Programs', href: '/programs' },
  { name: 'Pengumuman', href: '/pengumuman' },
  { name: 'UNIX Story', href: '/about' },
  { name: 'Informasi', href: '/about' },
  { name: 'UNIX Store', href: '/store' },
  { name: 'Takita', href: '/about' },
];

// Link WhatsApp Admin UNIX
const waLink = "https://wa.me/62895704906969?text=Halo%20min,%20saya%20mau%20tanya%20sesuatu%20terkait%20UNIX";
---

<footer class="footer">
  <div class="footer-container">
    
    <!-- ==========================================
         KOLOM 1: BRAND, DESKRIPSI & SOSMED + WHATSAPP
         ========================================== -->
    <div class="footer-col brand-col">
      <a href="/" class="logo-link">
        <Image src={logoImg} alt="Logo TemanKita" class="footer-logo" />
      </a>
      <p class="description">
        Kegiatan ternama di Sumatra Barat, merupakan bedah kampus terbesar di Sumatra Barat.
      </p>

      <div class="social-section">
        <span class="section-title">Ikuti Kami</span>
        <div class="social-links">
          <!-- Instagram -->
          <a href="https://instagram.com/unix.temankita" target="_blank" rel="noopener noreferrer" title="Instagram">
            <span class="sr-only">Instagram</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
            </svg>
          </a>

          <!-- TikTok -->
          <a href="https://tiktok.com/@unix.temankita" target="_blank" rel="noopener noreferrer" title="TikTok">
            <span class="sr-only">TikTok</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"></path>
            </svg>
          </a>

          <!-- WhatsApp -->
          <a href={waLink} target="_blank" rel="noopener noreferrer" class="wa-btn-icon" title="Chat WhatsApp">
            <span class="sr-only">WhatsApp</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>

    <!-- ==========================================
         KOLOM 2: PROGRAM (2 SUB-KOLOM)
         ========================================== -->
    <div class="footer-col">
      <span class="col-title">Program</span>
      <ul class="footer-links two-column-grid">
        {programLinks.map((prog) => (
          <li><a href={prog.href}>{prog.name}</a></li>
        ))}
      </ul>
    </div>

    <!-- ==========================================
         KOLOM 3: MENU BAR (2 SUB-KOLOM)
         ========================================== -->
    <div class="footer-col">
      <span class="col-title">Menu Bar</span>
      <ul class="footer-links two-column-grid">
        {menuBarLinks.map((menu) => (
          <li><a href={menu.href}>{menu.name}</a></li>
        ))}
      </ul>
    </div>

    <!-- ==========================================
         KOLOM 4: KONTAK RESMI
         ========================================== -->
    <div class="footer-col">
      <span class="col-title">Kontak</span>
      <ul class="contact-list">
        <li>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="contact-icon">
            <path d="M12 21s-6-5.686-6-10A6 6 0 0 1 18 11c0 4.314-6 10-6 10z"></path>
            <circle cx="12" cy="11" r="2.5"></circle>
          </svg>
          <span>Jln. Andalas No. 100, Andalas Timur, Andalas, Kota Padang, Sumatra Barat</span>
        </li>
        <li>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="contact-icon">
            <path d="M3 5.5A2.5 2.5 0 0 1 5.5 3h2.2a2 2 0 0 1 1.95 1.57l.6 2.7a2 2 0 0 1-.57 1.93l-1.3 1.3a14.05 14.05 0 0 0 6.15 6.15l1.3-1.3a2 2 0 0 1 1.93-.57l2.7.6A2 2 0 0 1 22 17.3v2.2a2.5 2.5 0 0 1-2.5 2.5A16.5 16.5 0 0 1 3 5.5z"></path>
          </svg>
          <a href="tel:0895704906969" class="contact-text-link">0895-7049-06969</a>
        </li>
        <li>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="contact-icon">
            <rect width="20" height="16" x="2" y="4" rx="2"></rect>
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
          </svg>
          <a href="mailto:temankitauniversityexpo@gmail.com" class="contact-text-link">temankitauniversityexpo@gmail.com</a>
        </li>
      </ul>
    </div>

  </div>

  <!-- ==========================================
       BAGIAN COPYRIGHT (SEJAJAR DI BAWAH)
       ========================================== -->
  <div class="footer-bottom">
    <div class="footer-bottom-container">
      <p class="copyright-text">
        &copy; {today.getFullYear()} <strong class="brand-bold">TemanKita University Expo</strong>. Semua hak cipta dilindungi.
      </p>
    </div>
  </div>
</footer>

<style>
  /* ===================================================
     [CSS 1] PENGATURAN AREA FOOTER (FULL MELEBAR)
     =================================================== */
  .footer {
    width: 100%;
    background-color: #000000;
    color: #ffffff;
    font-family: inherit;
    padding-top: 3rem;
    padding-bottom: 1.5rem;
    box-sizing: border-box;
  }

  .footer-container {
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
    padding-left: clamp(1.25rem, 4vw, 3.5rem);
    padding-right: clamp(1.25rem, 4vw, 3.5rem);
    box-sizing: border-box;
    display: grid;
    /* Proporsi 4 kolom: Brand, Program (2 kol), Menu Bar (2 kol), Kontak */
    grid-template-columns: 1.1fr 1.3fr 1.2fr 1.1fr;
    gap: clamp(1.5rem, 2.5vw, 2.5rem);
    align-items: start;
  }

  /* ===================================================
     [CSS 2] BRAND & SOSMED
     =================================================== */
  .footer-col {
    display: flex;
    flex-direction: column;
  }

  .logo-link {
    display: inline-block;
    margin-bottom: 0.75rem;
  }

  .footer-logo {
    height: 60px;
    width: auto;
    object-fit: contain;
    display: block;
  }

  .description {
    font-size: 0.85rem;
    line-height: 1.6;
    color: #cbd5e1;
    margin: 0 0 1.25rem 0;
    max-width: 300px;
  }

  .social-section {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .section-title,
  .col-title {
    display: inline-block;
    font-size: 0.95rem;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 0.85rem;
    position: relative;
    padding-bottom: 0.35rem;
    width: fit-content;
  }

  .section-title::after,
  .col-title::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 2.5px;
    background-color: #facc15;
    border-radius: 2px;
  }

  .social-links {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .social-links a {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.4);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    text-decoration: none;
    transition: all 0.25s ease;
  }

  .social-links a:hover {
    border-color: #facc15;
    color: #12055f;
    background-color: #facc15;
    transform: translateY(-2px);
  }

  .social-links svg {
    width: 17px;
    height: 17px;
  }

  .social-links a.wa-btn-icon:hover {
    border-color: #25d366;
    background-color: #25d366;
    color: #ffffff;
  }

  /* ===================================================
     [CSS 3] GRID 2 KOLOM (PROGRAM & MENU BAR)
     =================================================== */
  .footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  /* Class grid 2 kolom yang dipakai bersama oleh Program dan Menu Bar */
  .two-column-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem 1rem;
  }

  .footer-links a {
    text-decoration: none;
    color: #cbd5e1;
    font-size: 0.85rem;
    transition: color 0.2s ease, transform 0.2s ease;
    display: inline-block;
    line-height: 1.4;
  }

  .footer-links a:hover {
    color: #facc15;
    transform: translateX(3px);
  }

  /* ===================================================
     [CSS 4] LIST KONTAK
     =================================================== */
  .contact-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .contact-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.8rem;
    font-size: 0.85rem;
    color: #cbd5e1;
    line-height: 1.55;
  }

  .contact-icon {
    width: 18px;
    height: 18px;
    color: #facc15;
    flex-shrink: 0;
    margin-top: 4.5px;
  }

  .contact-text-link {
    color: #cbd5e1;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .contact-text-link:hover {
    color: #facc15;
  }

  /* ===================================================
     [CSS 5] COPYRIGHT BAWAH
     =================================================== */
  .footer-bottom {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.15);
    width: 100%;
  }

  .footer-bottom-container {
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
    padding-left: clamp(1.25rem, 4vw, 3.5rem);
    padding-right: clamp(1.25rem, 4vw, 3.5rem);
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .copyright-text {
    margin: 0;
    font-size: 0.82rem;
    color: #94a3b8;
    line-height: 1.5;
  }

  .brand-bold {
    font-weight: 700;
    color: #ffffff;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }

  /* ===================================================
     [CSS 6] RESPONSIF LAYAR
     =================================================== */
  @media (max-width: 1024px) {
    .footer-container {
      grid-template-columns: repeat(2, 1fr);
      gap: 2.5rem;
    }
  }

  @media (max-width: 640px) {
    .footer {
      padding-top: 2.5rem;
    }

    .footer-container {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .two-column-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.5rem 1rem;
    }
  }
</style>