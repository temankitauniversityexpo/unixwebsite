        <div class="site-container">
          <div class="section-center-head">
            <div class="superteam-badge-pill">CORE LEADER</div>
            <h3 class="styled-superteam-title navy-text">
              SUPERTEAM
              <span class="styled-sub-expo">TEMANKITA UNIVERSITY EXPO 2024</span>
            </h3>
