      <!-- Piringan CD Berputar: setengah masuk ke frame tulisan -->
      <div class="cd-vinyl-disc" id="cd-vinyl">
        <div class="cd-groove-ring ring-1"></div>
        <div class="cd-groove-ring ring-2"></div>
        <div class="cd-label-core">
          <div class="cd-hole"></div>
        </div>
      </div>

      <!-- Frame Wadah Tulisan dengan Keterangan Status -->
      <div class="cd-frame-label">
        <span class="cd-main-text">Anthem TemanKita</span>
        <span class="cd-status-indicator" id="cd-status">Sedang diputar</span>
      </div>

      <audio id="anthem-audio" src={anthemTemanKita} preload="auto" loop></audio>
    </div>

    <Footer />
  </body>
</html>

<script>
  // ==========================================
  // SLIDESHOW MASKOT OWIX (4 FOTO BERUBAH BERGANTIAN)
  // ==========================================
  const owixSlides = document.querySelectorAll('#owix-slideshow .mascot-slide-img');
  let currentOwixIdx = 0;

  if (owixSlides.length > 1) {
    setInterval(() => {
      owixSlides[currentOwixIdx]?.classList.remove('active');
      currentOwixIdx = (currentOwixIdx + 1) % owixSlides.length;
      owixSlides[currentOwixIdx]?.classList.add('active');
    }, 2800);
  }

  // ==========================================
  // LOGIKA AUDIO CD ANTHEM (1x PAUSE/PLAY, 2x DOWNLOAD)
  // ==========================================
  const anthemAudio = document.getElementById('anthem-audio') as HTMLAudioElement;
  const anthemWidget = document.getElementById('anthem-widget');
  const cdVinyl = document.getElementById('cd-vinyl');
  const cdStatus = document.getElementById('cd-status');

  let clickTimer: any = null;

  function startMusic() {
    if (!anthemAudio) return;
    anthemAudio.play().then(() => {
      cdVinyl?.classList.add('cd-spinning');
      if (cdStatus) cdStatus.textContent = 'Sedang diputar';
    }).catch(() => {
      if (cdStatus) cdStatus.textContent = 'Jeda';
    });
  }

  function stopMusic() {
    if (!anthemAudio) return;
    anthemAudio.pause();
    cdVinyl?.classList.remove('cd-spinning');
    if (cdStatus) cdStatus.textContent = 'Jeda';
  }

  function toggleMusic() {
    if (!anthemAudio) return;
    if (anthemAudio.paused) {
      startMusic();
    } else {
      stopMusic();
    }
  }

  function downloadAudio() {
    const link = document.createElement('a');
    link.href = (anthemAudio as any)?.src || '/TemanKita.mp3';
    link.download = 'TemanKita.mp3';
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
  }

  // 1x klik: Pause/Play | 2x klik cepat: Download
  anthemWidget?.addEventListener('click', () => {
    if (clickTimer === null) {
      clickTimer = setTimeout(() => {
        clickTimer = null;
        toggleMusic();
      }, 260);
    }
  });

  anthemWidget?.addEventListener('dblclick', () => {
    if (clickTimer) {
      clearTimeout(clickTimer);
      clickTimer = null;
    }
    downloadAudio();
  });

  // Otomatis mulai saat masuk halaman
  window.addEventListener('DOMContentLoaded', () => {
    startMusic();
  });

  // Fallback 1x interaksi jika terhalang autoplay policy browser
  const docInteractionPlay = () => {
    if (anthemAudio && anthemAudio.paused) {
      startMusic();
    }
    window.removeEventListener('click', docInteractionPlay);
