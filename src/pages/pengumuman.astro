---
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import { SITE_TITLE } from '../consts';

// Import Aset Gambar
import logoNama from '../assets/logo nama.png';
import gambarProfil from '../assets/Gambar Profil.png';
import docBg from '../assets/Doc1.jpg';
---

<!doctype html>
<html lang="id">
  <head>
    <BaseHead 
      title={`Pengumuman Volunteer UNIX 2027 - ${SITE_TITLE}`} 
      description="Pengumuman Resmi Hasil Seleksi Volunteer TemanKita University Expo 2027." 
    />
    <script is:inline src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.3/dist/confetti.browser.min.js"></script>
  </head>
  <body class="portal-body" style={`--bg-url: url('${docBg.src}');`}>
    
    <!-- Canvas Efek Bara Api Jika Tidak Lulus -->
    <canvas id="fire-canvas" class="fire-canvas hidden"></canvas>

    <!-- Overlay Countdown 5 4 3 2 1 -->
    <div class="reveal-countdown-overlay hidden" id="reveal-countdown-overlay">
      <div class="countdown-pulse-box">
        <span class="countdown-pulse-num" id="countdown-pulse-num">5</span>
        <p class="countdown-pulse-label">Membuka Status Hasil Seleksi...</p>
      </div>
    </div>

    <main class="portal-main-wrapper">
      <div class="portal-landscape-box">
        
        <!-- 1. KONDISI LEBIH 12 JAM: COMING SOON -->
        <div class="portal-glass-panel coming-soon-panel hidden" id="panel-coming-soon">
          <div class="portal-header-banner">
            <div class="header-logo-row">
              <Image src={logoNama} alt="Logo TemanKita UNIX" class="header-logo-img" />
            </div>
            <h2 class="banner-headline">PENGUMUMAN HASIL SELEKSI VOLUNTEER UNIX 2027</h2>
          </div>
          <div class="coming-soon-body text-center">
            <span class="badge-status-pill">STATUS PORTAL</span>
            <h1 class="coming-soon-title">COMING SOON</h1>
            <p class="coming-soon-desc">
              Portal pengumuman hasil seleksi Volunteer UNIX 2027 belum dibuka. Pantau terus jadwal resmi yang telah ditetapkan panitia.
            </p>
            <div class="target-date-box" id="cs-target-date">Menghubungkan ke jadwal rilis...</div>
          </div>
        </div>

        <!-- 2. KONDISI H-6 JAM: COUNTDOWN HITUNG MUNDUR -->
        <div class="portal-glass-panel countdown-panel hidden" id="panel-countdown">
          <div class="portal-header-banner">
            <div class="header-logo-row">
              <Image src={logoNama} alt="Logo TemanKita UNIX" class="header-logo-img" />
            </div>
            <h2 class="banner-headline">PENGUMUMAN HASIL SELEKSI VOLUNTEER UNIX 2027</h2>
          </div>
          <div class="countdown-body text-center">
            <span class="badge-status-pill pill-countdown">HITUNG MUNDUR RILIS (H-6 JAM)</span>
            <div class="countdown-digits-row">
              <div class="digit-box"><span id="cd-hours">00</span><label>Jam</label></div>
              <div class="digit-sep">:</div>
              <div class="digit-box"><span id="cd-minutes">00</span><label>Menit</label></div>
              <div class="digit-sep">:</div>
              <div class="digit-box"><span id="cd-seconds">00</span><label>Detik</label></div>
            </div>
            <p class="countdown-note-text">Formulir verifikasi akun pendaftar akan terbuka otomatis begitu hitung mundur selesai.</p>
          </div>
        </div>

        <!-- 3. KONDISI WAKTU TIBA: FORM VERIFIKASI -->
        <div class="portal-glass-panel form-panel hidden" id="panel-form">
          <div class="portal-header-banner">
            <div class="header-logo-row">
              <Image src={logoNama} alt="TemanKita University Expo 2027" class="header-logo-img" />
            </div>
            <h2 class="banner-headline">PENGUMUMAN HASIL SELEKSI VOLUNTEER UNIX 2027</h2>
          </div>

          <div class="portal-form-body">
            <p class="form-instruction-text">
              Masukkan Gmail Pendaftar dan Password akun yang telah Anda daftarkan di platform.
            </p>

            <form id="volunteer-check-form">
              <div class="form-field-group">
                <label class="field-label">Gmail Pendaftar</label>
                <input 
                  type="email" 
                  id="input-gmail" 
                  placeholder="Masukkan alamat email pendaftar Anda" 
                  class="snpmb-input" 
                  required 
                />
                <span class="field-hint">Pastikan penulisan Gmail sesuai saat mendaftar.</span>
              </div>

              <div class="form-field-group">
                <label class="field-label">Password Akun</label>
                <div class="input-password-wrap">
                  <input 
                    type="password" 
                    id="input-pass" 
                    placeholder="Masukkan password akun Anda" 
                    class="snpmb-input" 
                    required 
                  />
                  <button type="button" class="btn-toggle-eye" id="btn-toggle-eye" aria-label="Lihat Password">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="eye-svg">
                      <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path>
                      <circle cx="12" cy="12" r="3"></circle>
                    </svg>
                  </button>
                </div>
                <span class="field-error-text hidden" id="error-inline-msg">Akun atau password yang Anda masukkan tidak sesuai.</span>
              </div>

              <div class="form-checkbox-row">
                <input type="checkbox" id="check-statement" required />
                <label for="check-statement">
                  Dengan ini saya menyatakan bahwa data yang saya masukkan adalah sah dan benar milik saya pribadi.
                </label>
              </div>

              <div class="form-action-row" id="initial-action-row">
                <button type="submit" class="btn-snpmb-blue" id="btn-submit-check">
                  Periksa Akun
                </button>
              </div>
            </form>

            <div class="chameleon-reveal-wrap hidden" id="chameleon-reveal-wrap">
              <p class="chameleon-guide-text">✓ Akun Anda Terverifikasi! Tekan tombol di bawah untuk membuka hasil:</p>
              <button type="button" class="btn-chameleon-pulsing" id="btn-open-result">
                LIHAT PENGUMUMAN
              </button>
            </div>
          </div>
        </div>

        <!-- 4. KARTU HASIL SELEKSI RESMI (LANDSCAPE MELEBAR) -->
        <div class="portal-result-card-landscape hidden" id="portal-result-card">
          <!-- Header Banner Status (Hijau / Merah) -->
          <div class="result-header-strip" id="result-header-strip">
            <div class="header-strip-left">
              <h2 class="result-status-title" id="result-status-title">ANDA DINYATAKAN LULUS VOLUNTEER UNIX 2027</h2>
              <p class="result-status-quote" id="result-status-quote"></p>
            </div>
            <div class="header-strip-logo">
              <Image src={gambarProfil} alt="Logo UNIX" class="logo-plain-unboxed" />
            </div>
          </div>

          <!-- Bagian Detail Identitas Sesuai Ketentuan -->
          <div class="result-identity-body">
            <div class="metadata-custom-grid">
              <div class="meta-side-col left-col">
                <span class="label-tiny">Nama Lengkap</span>
                <span class="value-prominent" id="result-candidate-name">-</span>
              </div>

              <div class="meta-side-col right-col">
                <span class="label-tiny">No.Registrasi</span>
                <span class="value-prominent text-code" id="result-candidate-noreg">-</span>
              </div>

              <div class="meta-grid-divider"></div>

              <div class="meta-side-col left-col empty-col"></div>

              <div class="meta-side-col right-col">
                <span class="label-tiny">Alamat gmail</span>
                <span class="value-prominent text-email" id="result-candidate-email">-</span>
              </div>
            </div>

            <!-- KOTAK BARCODE WAJIB CHAT KE ADMIN UNIX (KHUSUS YANG LULUS) -->
            <div class="whatsapp-qr-container hidden" id="whatsapp-qr-container">
              <div class="qr-content-card">
                <div class="qr-image-frame">
                  <img id="qr-whatsapp-img" src="" alt="Barcode Chat WhatsApp Admin UNIX" class="qr-code-img" />
                </div>
                <div class="qr-desc-col">
                  <span class="qr-badge-pill">KONFIRMASI PENERIMAAN VOLUNTEER</span>
                  <h4 class="qr-heading-title">Chat Admin UNIX untuk Bergabung ke Grup</h4>
                  <p class="qr-instruction-text">
                    Scan barcode di samping atau klik tombol di bawah untuk konfirmasi langsung ke WhatsApp Admin UNIX (<strong>0895-7049-06969</strong>) dan bergabung ke grup resmi.
                  </p>
                  <a href="" id="btn-direct-wa" target="_blank" rel="noopener noreferrer" class="btn-contact-admin-solid">
                    Hubungi Admin Sekarang! &rarr;
                  </a>
                </div>
              </div>
            </div>

            <!-- Pesan Informasi Auto Refresh -->
            <div class="refresh-countdown-notice">
              <span class="refresh-dot"></span>
              <span>Halaman akan memuat ulang otomatis dalam <strong id="refresh-timer-count">15</strong> detik.</span>
            </div>
          </div>
        </div>

        <!-- NAVIGASI BAWAH MENETAP (KIRI: ADMIN PENDAFTARAN | KANAN: KELUAR) -->
        <footer class="portal-bottom-nav">
          <button type="button" class="btn-bottom-nav btn-admin-gate" id="btn-open-admin-gate" title="Khusus Panitia Seleksi">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="nav-btn-icon"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
            <span>Admin Pendaftaran</span>
          </button>

          <a href="/" class="btn-bottom-nav btn-exit-nav" title="Kembali ke Beranda">
            <span>Keluar</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="nav-btn-icon">
              <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
              <polyline points="16 17 21 12 16 7"></polyline>
              <line x1="21" y1="12" x2="9" y2="12"></line>
            </svg>
          </a>
        </footer>

      </div>
    </main>

    <!-- Modal Pop-Up Silang Error (5 Detik) -->
    <div class="modal-backdrop-clean hidden" id="error-popup-modal">
      <div class="modal-dialog-error">
        <div class="error-cross-circle">✖</div>
        <h3 class="error-title">Data Akun Tidak Cocok!</h3>
        <p class="error-desc" id="error-desc-text">Gmail atau Password yang Anda masukkan tidak sesuai dengan database pendaftar. Silakan periksa kembali.</p>
        <div class="error-countdown-bar">
          <div class="countdown-progress-fill"></div>
        </div>
      </div>
    </div>

    <!-- Modal Pop-Up PIN Verifikasi Akses Admin (A1B2C3) -->
    <div class="modal-backdrop-clean hidden" id="pin-modal-overlay">
      <div class="modal-dialog-pin">
        <div class="pin-icon-wrap">🔒</div>
        <h3 class="pin-modal-title">Autentikasi Panitia</h3>
        <p class="pin-modal-desc">Masukkan PIN Keamanan untuk membuka portal pengelolaan data seleksi pendaftaran.</p>
        
        <div class="pin-input-group">
          <input 
            type="password" 
            id="input-admin-pin" 
            placeholder="Ketik PIN..." 
            class="pin-field-clean" 
            maxlength="10" 
            autocomplete="off"
          />
          <span class="pin-error-msg hidden" id="pin-error-msg">PIN salah! Akses ditolak.</span>
        </div>

        <div class="pin-btn-actions">
          <button type="button" class="btn-pin-cancel" id="btn-cancel-pin">Batal</button>
          <button type="button" class="btn-pin-submit" id="btn-submit-pin">Buka Portal</button>
        </div>
      </div>
    </div>
  </body>
</html>

<script>
  let pendaftaranConfig = {
    schedule: '',
    waLink: 'https://chat.whatsapp.com/LJk3X0aPRnHCi5mDjhj0E8?s=sh&p=a&iam=2'
  };

  try {
    const savedConfig = localStorage.getItem('unix_pendaftaran_config');
    if (savedConfig) pendaftaranConfig = JSON.parse(savedConfig);
  } catch (e) {
    console.warn(e);
  }

  let gradData: any[] = [];
  try {
    gradData = JSON.parse(localStorage.getItem('unix_pendaftaran_grad_data') || '[]');
  } catch (e) {
    gradData = [];
  }

  const panelComingSoon = document.getElementById('panel-coming-soon');
  const panelCountdown = document.getElementById('panel-countdown');
  const panelForm = document.getElementById('panel-form');
  const csTargetDate = document.getElementById('cs-target-date');

  const cdHours = document.getElementById('cd-hours');
  const cdMin = document.getElementById('cd-minutes');
  const cdSec = document.getElementById('cd-seconds');

  const formEl = document.getElementById('volunteer-check-form');
  const inputGmail = document.getElementById('input-gmail') as HTMLInputElement;
  const inputPass = document.getElementById('input-pass') as HTMLInputElement;
  const errorInlineMsg = document.getElementById('error-inline-msg');
  const btnToggleEye = document.getElementById('btn-toggle-eye');

  const initialActionRow = document.getElementById('initial-action-row');
  const chameleonWrap = document.getElementById('chameleon-reveal-wrap');
  const btnOpenResult = document.getElementById('btn-open-result');

  const revealOverlay = document.getElementById('reveal-countdown-overlay');
  const countdownNumEl = document.getElementById('countdown-pulse-num');
  const resultCard = document.getElementById('portal-result-card');

  const resultHeaderStrip = document.getElementById('result-header-strip');
  const resultStatusTitle = document.getElementById('result-status-title');
  const resultStatusQuote = document.getElementById('result-status-quote');
  const resultCandidateName = document.getElementById('result-candidate-name');
  const resultCandidateEmail = document.getElementById('result-candidate-email');
  const resultCandidateNoreg = document.getElementById('result-candidate-noreg');

  const whatsappQrContainer = document.getElementById('whatsapp-qr-container');
  const qrWhatsappImg = document.getElementById('qr-whatsapp-img') as HTMLImageElement;
  const btnDirectWa = document.getElementById('btn-direct-wa') as HTMLAnchorElement;
  const refreshTimerCount = document.getElementById('refresh-timer-count');

  const errorModal = document.getElementById('error-popup-modal');
  const fireCanvas = document.getElementById('fire-canvas') as HTMLCanvasElement;

  const pinModal = document.getElementById('pin-modal-overlay');
  const btnOpenAdminGate = document.getElementById('btn-open-admin-gate');
  const btnCancelPin = document.getElementById('btn-cancel-pin');
  const btnSubmitPin = document.getElementById('btn-submit-pin');
  const inputAdminPin = document.getElementById('input-admin-pin') as HTMLInputElement;
  const pinErrorMsg = document.getElementById('pin-error-msg');

  let errorTimer: any = null;
  let verifiedCandidate: any = null;

  btnToggleEye?.addEventListener('click', () => {
    inputPass.type = inputPass.type === 'password' ? 'text' : 'password';
  });

  let targetDateTime = pendaftaranConfig.schedule;
  if (targetDateTime) {
    const dtObj = new Date(targetDateTime);
    if (csTargetDate) {
      csTargetDate.textContent = `Jadwal Rilis: ${dtObj.toLocaleString('id-ID', { dateStyle: 'full', timeStyle: 'short' })} WIB`;
    }
  } else {
    const defaultTime = new Date();
    defaultTime.setHours(defaultTime.getHours() + 14);
    targetDateTime = defaultTime.toISOString();
    if (csTargetDate) csTargetDate.textContent = 'Jadwal Rilis: Segera Diumumkan Panitia';
  }

  function evaluateTimePhase() {
    const targetTime = new Date(targetDateTime).getTime();
    const now = new Date().getTime();
    const distance = targetTime - now;
    const SIX_HOURS = 6 * 60 * 60 * 1000;

    if (distance <= 0) {
      panelComingSoon?.classList.add('hidden');
      panelCountdown?.classList.add('hidden');
      panelForm?.classList.remove('hidden');
      return true;
    } else if (distance <= SIX_HOURS) {
      panelComingSoon?.classList.add('hidden');
      panelCountdown?.classList.remove('hidden');
      panelForm?.classList.add('hidden');

      const hours = Math.floor(distance / (1000 * 60 * 60));
      const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
      const seconds = Math.floor((distance % (1000 * 60)) / 1000);

      if (cdHours) cdHours.textContent = hours.toString().padStart(2, '0');
      if (cdMin) cdMin.textContent = minutes.toString().padStart(2, '0');
      if (cdSec) cdSec.textContent = seconds.toString().padStart(2, '0');
      return false;
    } else {
      panelComingSoon?.classList.remove('hidden');
      panelCountdown?.classList.add('hidden');
      panelForm?.classList.add('hidden');
      return false;
    }
  }

  const isReleased = evaluateTimePhase();
  if (!isReleased) {
    const timerInterval = setInterval(() => {
      const finished = evaluateTimePhase();
      if (finished) clearInterval(timerInterval);
    }, 1000);
  }

  // Verifikasi Akun Pendaftar
  formEl?.addEventListener('submit', (e) => {
    e.preventDefault();

    const emailVal = inputGmail.value.trim().toLowerCase();
    const passVal = inputPass.value.trim();

    try {
      gradData = JSON.parse(localStorage.getItem('unix_pendaftaran_grad_data') || '[]');
    } catch {
      gradData = [];
    }

    const targetUser = gradData.find((g: any) => {
      const cEmail = (g.email || '').toLowerCase().trim();
      const cPass = (g.password || g.pass || '').trim();
      return cEmail === emailVal && cPass === passVal;
    });

    if (targetUser) {
      verifiedCandidate = targetUser;
      errorInlineMsg?.classList.add('hidden');
      initialActionRow?.classList.add('hidden');
      chameleonWrap?.classList.remove('hidden');
    } else {
      errorInlineMsg?.classList.remove('hidden');
      showErrorPopup('Gmail atau Password Anda salah / tidak terdaftar dalam database seleksi.');
    }
  });

  function showErrorPopup(msg: string) {
    const errorDesc = document.getElementById('error-desc-text');
    if (errorDesc) errorDesc.textContent = msg;
    errorModal?.classList.remove('hidden');

    if (errorTimer) clearTimeout(errorTimer);
    errorTimer = setTimeout(() => {
      errorModal?.classList.add('hidden');
    }, 5000);
  }

  // Buka Hasil Seleksi & Mulai Timer Auto-Refresh 5 Detik
  btnOpenResult?.addEventListener('click', () => {
    if (!verifiedCandidate) return;

    revealOverlay?.classList.remove('hidden');

    let count = 5;
    if (countdownNumEl) {
      countdownNumEl.textContent = count.toString();
      restartPulseAnimation(countdownNumEl);
    }

    const interval = setInterval(() => {
      count--;
      if (count > 0) {
        if (countdownNumEl) {
          countdownNumEl.textContent = count.toString();
          restartPulseAnimation(countdownNumEl);
        }
      } else {
        clearInterval(interval);
        revealOverlay?.classList.add('hidden');

        panelForm?.classList.add('hidden');
        resultCard?.classList.remove('hidden');

        renderFinalResult();

        // HITUNG MUNDUR AUTO-REFRESH 5 DETIK
        let refreshSeconds = 5;
        if (refreshTimerCount) refreshTimerCount.textContent = refreshSeconds.toString();

        const refreshInterval = setInterval(() => {
          refreshSeconds--;
          if (refreshTimerCount) refreshTimerCount.textContent = refreshSeconds.toString();
          if (refreshSeconds <= 0) {
            clearInterval(refreshInterval);
            window.location.reload();
          }
        }, 1000);
      }
    }, 1000);
  });

  function restartPulseAnimation(el: HTMLElement) {
    el.style.animation = 'none';
    void el.offsetWidth;
    el.style.animation = 'pulseScaleNum 0.9s cubic-bezier(0.16, 1, 0.3, 1)';
  }

  function renderFinalResult() {
    const isPass = (verifiedCandidate.status || '').toUpperCase().trim() === 'LULUS';
    const candidateName = verifiedCandidate.name || '-';
    const candidateEmail = verifiedCandidate.email || '-';
    const candidateReg = verifiedCandidate.noreg || '-';

    if (resultCandidateName) resultCandidateName.textContent = candidateName;
    if (resultCandidateEmail) resultCandidateEmail.textContent = candidateEmail;
    if (resultCandidateNoreg) resultCandidateNoreg.textContent = candidateReg;

    if (isPass) {
      resultHeaderStrip?.classList.remove('strip-fail');
      resultHeaderStrip?.classList.add('strip-pass');

      if (resultStatusTitle) {
        resultStatusTitle.textContent = 'ANDA DINYATAKAN LULUS VOLUNTEER UNIX 2027';
      }
      if (resultStatusQuote) {
        resultStatusQuote.textContent = '"Selamat SobatKita telah tergabung di Keluarga Besar TemanKita University Expo 2027, semoga kita dapat bekerjasama dengan baik kedepannya, Selamat dan Semangat SobatKita!"';
      }

      const targetWaUrl = pendaftaranConfig.waLink || 'https://chat.whatsapp.com/LJk3X0aPRnHCi5mDjhj0E8?s=sh&p=a&iam=2';

      if (qrWhatsappImg) {
        qrWhatsappImg.src = `https://api.qrserver.com/v1/create-qr-code/?size=220x220&data=${encodeURIComponent(targetWaUrl)}`;
      }
      if (btnDirectWa) {
        btnDirectWa.href = targetWaUrl;
      }

      whatsappQrContainer?.classList.remove('hidden');
      launchConfetti();
    } else {
      resultHeaderStrip?.classList.remove('strip-pass');
      resultHeaderStrip?.classList.add('strip-fail');

      if (resultStatusTitle) {
        resultStatusTitle.textContent = 'ANDA DINYATAKAN TIDAK LULUS VOLUNTEER UNIX 2027';
      }
      if (resultStatusQuote) {
        resultStatusQuote.textContent = '"Tetap semangat SobatKita ini bukanlah akhir masih banyak kesempatan untuk kita berkembang lebih baik, cari terus kesempatan itu, Semangat SobatKita!"';
      }

      whatsappQrContainer?.classList.add('hidden');
      startFireParticles();
    }
  }

  function launchConfetti() {
    try {
      if (typeof (window as any).confetti === 'function') {
        const duration = 5 * 1000;
        const end = Date.now() + duration;

        (function frame() {
          (window as any).confetti({ particleCount: 5, angle: 60, spread: 55, origin: { x: 0, y: 0.7 } });
          (window as any).confetti({ particleCount: 5, angle: 120, spread: 55, origin: { x: 1, y: 0.7 } });
          if (Date.now() < end) requestAnimationFrame(frame);
        })();
      }
    } catch (e) {
      console.warn(e);
    }
  }

  function startFireParticles() {
    if (!fireCanvas) return;
    fireCanvas.classList.remove('hidden');

    const ctx = fireCanvas.getContext('2d');
    if (!ctx) return;

    let width = (fireCanvas.width = window.innerWidth);
    let height = (fireCanvas.height = window.innerHeight);

    window.addEventListener('resize', () => {
      width = fireCanvas.width = window.innerWidth;
      height = fireCanvas.height = window.innerHeight;
    });

    const particles: any[] = [];
    for (let i = 0; i < 80; i++) {
      particles.push({
        x: Math.random() * width,
        y: height + Math.random() * 80,
        radius: Math.random() * 4 + 2,
        speedY: Math.random() * 3 + 1.5,
        speedX: (Math.random() - 0.5) * 1.5,
        alpha: Math.random() * 0.7 + 0.3,
        color: Math.random() > 0.4 ? '#f59e0b' : '#ef4444'
      });
    }

    function animateFire() {
      if (!ctx) return;
      ctx.clearRect(0, 0, width, height);

      particles.forEach((p) => {
        p.y -= p.speedY;
        p.x += p.speedX;
        p.alpha -= 0.005;

        if (p.y < 0 || p.alpha <= 0) {
          p.x = Math.random() * width;
          p.y = height + 10;
          p.alpha = Math.random() * 0.7 + 0.3;
        }

        ctx.save();
        ctx.globalAlpha = p.alpha;
        ctx.fillStyle = p.color;
        ctx.shadowBlur = 12;
        ctx.shadowColor = p.color;
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
        ctx.fill();
        ctx.restore();
      });

      requestAnimationFrame(animateFire);
    }

    animateFire();
  }

  // Autentikasi PIN Gate
  btnOpenAdminGate?.addEventListener('click', () => {
    if (inputAdminPin) inputAdminPin.value = '';
    pinErrorMsg?.classList.add('hidden');
    pinModal?.classList.remove('hidden');
    inputAdminPin?.focus();
  });

  btnCancelPin?.addEventListener('click', () => {
    pinModal?.classList.add('hidden');
  });

  function verifyAdminPin() {
    const pinVal = inputAdminPin ? inputAdminPin.value.trim() : '';
    if (pinVal === 'A1B2C3') {
      sessionStorage.setItem('unix_pendaftaran_auth', 'granted');
      window.location.href = '/adminpendaftaran';
    } else {
      pinErrorMsg?.classList.remove('hidden');
      inputAdminPin?.focus();
    }
  }

  btnSubmitPin?.addEventListener('click', verifyAdminPin);
  inputAdminPin?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') verifyAdminPin();
  });
</script>

