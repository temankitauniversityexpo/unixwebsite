---
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Slide from '../components/SlideHero.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

// ==========================================
// 1. IMPORT ASSET GAMBAR
// ==========================================
import accImg from '../assets/acc.png';
import panitiaImg from '../assets/panitia.png';
import smaImg from '../assets/sma.png';

// Kolase Foto About
import collage1 from '../assets/Doc1.jpg';
import collage2 from '../assets/Doc3.jpg';
import collage3 from '../assets/Doc2.jpg';

// 10 Foto Dokumentasi Berbeda
// (Pastikan file Doc1.jpg sampai Doc10.jpg ada di folder src/assets/)
import doc1 from '../assets/Doc1.jpg';
import doc2 from '../assets/Doc2.jpg';
import doc3 from '../assets/Doc3.jpg';
import doc4 from '../assets/Doc4.png';
import doc5 from '../assets/Doc5.png';
import doc6 from '../assets/Doc6.png';
import doc7 from '../assets/Doc7.png';
import doc8 from '../assets/Doc8.png';
import doc9 from '../assets/Doc9.png';
import doc10 from '../assets/Doc10.png';

// ==========================================
// 2. DATA 6 PILIHAN PETAK CEPAT
// ==========================================
const quickBoxes = [
  { title: 'UNIX Programs', desc: 'Cari tahu rangkaian kegiatannya', icon: '🎯', href: '/programs', locked: false },
  { title: 'UNIX Store', desc: 'Banyak Makanan dan Marchandise menarik', icon: '🛍️', href: '/store', locked: false },
  { title: 'UNIX Story', desc: 'Cerita perjalanan menarik dari UNIX', icon: '📖', href: '/about', locked: false },
  { title: 'Informasi', desc: 'Update informasi dari media sosial UNIX', icon: '📢', href: '/informasi', locked: true },
  { title: 'Pengumuman', desc: 'Cek hasil kelulusan volunteer UNIX', icon: '📋', href: '/pengumuman', locked: false },
  { title: 'Takita', desc: 'Tanya Kita tempat sharing dan bertanya', icon: '💬', href: '/takita', locked: true },
];

// ==========================================
// 3. DATA APA KATA MEREKA (10 ORANG BERBEDA)
// ==========================================
const testimonialsText = [
  {
    id: 1,
    name: 'Fazl Islami Pasha',
    role: 'Peserta UNIX',
    campus: 'Universitas Andalas',
    message: 'UNIX membuka wawasan saya tentang dunia perkuliahan dan membantu saya yakin memilih jurusan yang sesuai minat.',
  },
  {
    id: 2,
    name: 'Nayla Aliya Syarlita',
    role: 'Volunteer UNIX',
    campus: 'Institut Teknologi Bandung',
    message: 'Pengalaman luar biasa bisa berinteraksi langsung dengan adik-adik SMA dan berbagi tips lolos kampus impian.',
  },
  {
    id: 3,
    name: 'Alentio Ghany Pahlevi',
    role: 'Peserta Bedah Kampus',
    campus: 'Universitas Indonesia',
    message: 'Bimbingan dan simulasi ujian di UNIX sangat realistis, atmosfer kompetitifnya benar-benar terasa.',
  },
  {
    id: 4,
    name: 'Jovan Ramadhani',
    role: 'Volunteer UNIX',
    campus: 'Universitas Andalas',
    message: 'Bukan cuma belajar akademik, relasi dan kepanitiaan di TemanKita mempertemukan saya dengan teman-teman hebat se-Sumbar.',
  },
  {
    id: 5,
    name: 'Musthafa Akram',
    role: 'Peserta Mentoring',
    campus: 'Institut Pertanian Bogor',
    message: 'Sesi mentoring eksklusifnya sangat intensif, tips lolos beasiswa yang dibagikan benar-benar aplikatif.',
  },
  {
    id: 6,
    name: 'Aisyah Putri Rahmadani',
    role: 'Peserta UNIX',
    campus: 'Universitas Gadjah Mada',
    message: 'Awalnya ragu menentukan target jurusan, tapi setelah sharing di booth kampus UNIX, semua pilihan jadi jauh lebih jelas.',
  },
  {
    id: 7,
    name: 'Rifqi Pratama',
    role: 'Volunteer Divisi Acara',
    campus: 'Universitas Padjadjaran',
    message: 'Bangga menjadi bagian dari perhelatan bedah kampus terbesar ini. Energi dan antusiasme pesertanya luar biasa.',
  },
  {
    id: 8,
    name: 'Dinda Maharani',
    role: 'Peserta Try Out',
    campus: 'Universitas Diponegoro',
    message: 'Pembahasan soal Try Out dan bedah materi SNBT-nya sangat komprehensif serta mudah dipahami.',
  },
  {
    id: 9,
    name: 'Fauzan Fadhlurrahman',
    role: 'Delegasi Kampus',
    campus: 'Universitas Brawijaya',
    message: 'Senang bisa mewakili paguyuban kampus mengenalkan seluk-beluk fakultas dan kehidupan mahasiswa di rantau.',
  },
  {
    id: 10,
    name: 'Syifa Nurul Izzah',
    role: 'Peserta Bedah Kampus',
    campus: 'Universitas Negeri Padang',
    message: 'Event yang sangat inspiratif untuk siswa SMA yang sedang mencari arah dan motivasi melanjutkan pendidikan.',
  },
];

// ==========================================
// 4. DATA VIDEO TESTIMONI
// ==========================================
const videoTestimonials = [
  { id: '1', name: 'Alentio Ghany Pahlevi', campus: 'Universitas Indonesia' },
  { id: '2', name: 'Nayla Aliya Syarlita', campus: 'Institut Teknologi Bandung' },
  { id: '3', name: 'Aisyah Putri Rahmadani', campus: 'Universitas Gadjah Mada' },
  { id: '4', name: 'Jovan Ramadhani', campus: 'Universitas Andalas' },
  { id: '5', name: 'Rifqi Pratama', campus: 'Universitas Padjadjaran' },
  { id: '6', name: 'Musthafa Akram', campus: 'Institut Pertanian Bogor' },
  { id: '7', name: 'Dinda Maharani', campus: 'Universitas Diponegoro' },
];

// ==========================================
// 5. DATA TIMELINE ULAR (12 AGENDA)
// ==========================================
const row1 = [
  { step: 'STEP 01', title: 'Open Recruitment', date: '18 - 21 Okt 2026' },
  { step: 'STEP 02', title: 'Pilih Jadwal Wawancara', date: '22 Okt 2026' },
  { step: 'STEP 03', title: 'Wawancara Volunteer', date: '23 - 30 Okt 2026' },
  { step: 'STEP 04', title: 'Rapat Kelulusan', date: '31 Okt 2026' },
];

const row2 = [
  { step: 'STEP 08', title: 'Dare Series & Try Out', date: '1 - 16 Jan 2027' },
  { step: 'STEP 07', title: 'Penyebaran Surat Izin', date: '9 - 19 Nov 2026' },
  { step: 'STEP 06', title: 'First Meet', date: '8 Nov 2026' },
  { step: 'STEP 05', title: 'Pengumuman Kelulusan', date: '1 Nov 2026' },
];

const row3 = [
  { step: 'STEP 09', title: 'Roadshow Kampus', date: '4 - 16 Jan 2027' },
  { step: 'STEP 10', title: 'Hari H Kegiatan', date: '17 Jan 2027' },
  { step: 'STEP 11', title: 'Mentoring 3x', date: '3 Bulan' },
  { step: 'STEP 12', title: 'Executive Summary', date: 'Tahap Akhir' },
];

// ==========================================
// 6. DOKUMENTASI (10 FOTO BERBEDA)
// ==========================================
const docPhotos = [
  doc1, doc2, doc3, doc4, doc5,
  doc6, doc7, doc8, doc9, doc10,
];
---

<!doctype html>
<html lang="id">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />

    <!-- ==========================================
         BAGIAN SLIDER HERO
         ========================================== -->
    <Slide />

    <!-- ==========================================
         FLOATING STATS CARD
         ========================================== -->
    <div class="stats-floating-wrapper">
      <div class="site-container">
        <div class="stats-badge-card">
          <div class="stats-left-badge">
            <Image src={accImg} alt="Terpercaya" class="acc-img-badge" />
            <div class="trust-text">
              <span class="trust-pill">Sejak 2024</span>
              <h4 class="trust-title">Bedah Kampus Terbesar di Sumatra Barat</h4>
            </div>
          </div>

          <div class="stats-right-metrics">
            <div class="metric-item">
              <Image src={panitiaImg} alt="Participant" class="metric-custom-img" />
              <div class="metric-content">
                <h5 class="metric-value">450+</h5>
                <span class="metric-label">Participant</span>
              </div>
            </div>

            <div class="metric-divider"></div>

            <div class="metric-item">
              <Image src={smaImg} alt="Peserta" class="metric-custom-img" />
              <div class="metric-content">
                <h5 class="metric-value">1200+</h5>
                <span class="metric-label">Peserta</span>
              </div>
            </div>

            <div class="metric-divider"></div>

            <div class="metric-item">
              <div class="rating-badge">★ 4.87/5</div>
              <span class="metric-label">Rating</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <main class="home-page">
      <!-- ==========================================
           BAGIAN 1: WELCOME & 6 PETAK
           ========================================== -->
      <section class="welcome-section">
        <div class="site-container">
          <div class="welcome-header">
            <h1 class="welcome-title">
              Welcome <span class="highlight-yellow">SobatKita</span>
            </h1>
            <p class="welcome-subtitle">
              Selamat datang di official website TemanKita University Expo, yuk cari tau tentang kegiatan ini.
            </p>
          </div>

          <div class="grid-boxes">
            {quickBoxes.map((box) => (
              <a 
                href={box.locked ? 'javascript:void(0)' : box.href} 
                class={`quick-box-card ${box.locked ? 'locked-feature-btn' : ''}`}
                data-feature-title={box.title}
              >
                <div class="box-icon">{box.icon}</div>
                <div class="box-text">
                  <h3 class="box-title">{box.title}</h3>
                  <p class="box-desc">{box.desc}</p>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>

      <!-- ==========================================
           BAGIAN 2: PENJELASAN (BG #12055f) & KOLASE
           ========================================== -->
      <section class="fullwidth-about-section">
        <div class="site-container about-container">
          <div class="about-content">
            <h2 class="about-title">
              Apa itu <span class="highlight-yellow">TemanKita University Expo?</span>
            </h2>

            <div class="about-description">
              <p>
                <strong>TemanKita University Expo</strong> adalah ajang eksplorasi dan bedah kampus terbesar yang dirancang khusus untuk mendampingi siswa-siswi SMA/SMK sederajat dalam menemukan arah perkuliahan yang tepat.
              </p>
              <p>
                Melalui interaksi langsung bersama delegasi perguruan tinggi negeri maupun swasta ternama, sesi bimbingan beasiswa eksklusif, simulasi ujian intensif, serta mentoring terarah, TemanKita hadir menjadi kawan seperjuanganmu dalam mewujudkan masa depan akademik yang gemilang.
              </p>
            </div>

            <div class="about-actions">
              <a href="/daftar" class="btn btn-yellow">Gabung Sekarang</a>
              <a 
                href="https://wa.me/62895704906969?text=Halo%20Admin%20TemanKita,%20saya%20mau%20tanya%20seputar%20University%20Expo" 
                target="_blank" 
                rel="noopener noreferrer" 
                class="btn btn-outline-white"
              >
                Tanya Admin
              </a>
            </div>
          </div>

          <div class="collage-wrapper">
            <div class="collage-item collage-1">
              <Image src={collage1} alt="Dokumentasi 1" class="collage-img" />
            </div>
            <div class="collage-item collage-2">
              <Image src={collage2} alt="Dokumentasi 2" class="collage-img" />
            </div>
            <div class="collage-item collage-3">
              <Image src={collage3} alt="Dokumentasi 3" class="collage-img" />
            </div>
          </div>
        </div>
      </section>

      <!-- ==========================================
           BAGIAN 3: APA KATA MEREKA (10 BUBBLE DARI 10 ORANG)
           ========================================== -->
      <section class="section-testimonials-marquee">
        <div class="site-container">
          <div class="section-badge-center">
            <h2 class="section-heading-single">
              Apa Kata Mereka?
            </h2>
          </div>
        </div>

        <div class="infinite-scroll-wrapper" id="scroll-testimonials" data-speed="1.2">
          <div class="infinite-scroll-track">
            {testimonialsText.map((item) => (
              <div class="bubble-card">
                <div class="bubble-header">
                  <!-- Avatar Anonim SVG -->
                  <div class="bubble-avatar-anon">
                    <svg viewBox="0 0 24 24" fill="currentColor">
                      <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                    </svg>
                  </div>
                  <div class="bubble-identity">
                    <h4 class="bubble-name">{item.name}</h4>
                    <p class="bubble-campus">{item.campus}</p>
                  </div>
                </div>
                <p class="bubble-quote">“{item.message}”</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- ==========================================
           BAGIAN 4: KENAPA MEMILIH UNIX? (BG #12055f)
           ========================================== -->
      <section class="fullwidth-why-section">
        <div class="site-container">
          <div class="why-header">
            <h2 class="why-title">
              Kenapa Memilih <span class="highlight-yellow">UNIX?</span>
            </h2>
            <p class="why-subtitle">
              Tiga alasan mendasar mengapa TemanKita University Expo menjadi wadah terbaik untuk masa depan pendidikanmu.
            </p>
          </div>

          <div class="why-grid">
            <div class="why-card">
              <div class="why-card-header">
                <h3 class="why-card-title">Informasi Kredibel</h3>
              </div>
              <div class="why-card-body">
                <p class="why-card-desc">
                  Informasi langsung berasal dari penerima beasiswa atau mahasiswa aktif kampusnya secara transparan, akurat, dan terpercaya tanpa perantara.
                </p>
              </div>
            </div>

            <div class="why-card">
              <div class="why-card-header">
                <h3 class="why-card-title">Relasi & Pengetahuan Luas</h3>
              </div>
              <div class="why-card-body">
                <p class="why-card-desc">
                  Tidak hanya mendapatkan wawasan dunia perkuliahan, Anda juga memperluas koneksi antarpelajar dari berbagai SMA/SMK di Sumatra Barat.
                </p>
              </div>
            </div>

            <div class="why-card">
              <div class="why-card-header">
                <h3 class="why-card-title">Benefit Luar Biasa</h3>
              </div>
              <div class="why-card-body">
                <p class="why-card-desc">
                  Banyak benefit nyata yang bisa didapatkan setelah bergabung menjadi Volunteer, Paguyuban kampus, maupun Peserta kegiatan.
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ==========================================
           BAGIAN 5: TESTIMONI VIDEO
           ========================================== -->
      <section class="section-video-testimonials">
        <div class="site-container">
          <div class="section-badge-center">
            <h2 class="section-heading-single">
              Testimoni Sobat UNIX
            </h2>
            <p class="section-desc-center">
              Dengarkan langsung cerita dan pengalaman nyata dari mereka yang telah bertumbuh bersama kami.
            </p>
          </div>
        </div>

        <div class="infinite-scroll-wrapper" id="scroll-videos" data-speed="1.0">
          <div class="infinite-scroll-track">
            {videoTestimonials.map((vid) => (
              <div class="video-card">
                <div 
                  class="video-thumbnail-box play-video-trigger"
                  data-name={vid.name}
                  data-campus={vid.campus}
                >
                  <div class="thumbnail-empty">
                    <span class="empty-icon">🎬</span>
                    <p class="empty-text">Segera Tayang</p>
                  </div>
                </div>
                <div class="video-info-box">
                  <h4 class="video-person-name">{vid.name}</h4>
                  <p class="video-person-campus">{vid.campus}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- ==========================================
           BAGIAN 6: TIMELINE TERDEKAT
           ========================================== -->
      <section class="fullwidth-timeline-section">
        <div class="site-container">
          <div class="timeline-header">
            <h2 class="timeline-title-white">
              Timeline Terdekat
            </h2>
            <p class="timeline-subtitle-white">
              Berikut gambaran rangkaian kegiatan yang akan di realisasikan
            </p>
          </div>

          <div class="snake-timeline-wrapper">
            <!-- BARIS 1: Kiri ke Kanan -->
            <div class="snake-row row-1">
              <div class="snake-line horizontal-line"></div>
              {row1.map((item) => (
                <div class="snake-node">
                  <div class="node-content text-top">
                    <span class="node-step">{item.step}</span>
                    <h4 class="node-title">{item.title}</h4>
                    <span class="node-date">{item.date}</span>
                  </div>
                  <div class="node-dot"></div>
                </div>
              ))}
              <div class="turn-right"></div>
            </div>

            <!-- BARIS 2: Berbalik Kanan ke Kiri -->
            <div class="snake-row row-2">
              <div class="snake-line horizontal-line"></div>
              {row2.map((item) => (
                <div class="snake-node">
                  <div class="node-content text-top">
                    <span class="node-step">{item.step}</span>
                    <h4 class="node-title">{item.title}</h4>
                    <span class="node-date">{item.date}</span>
                  </div>
                  <div class="node-dot"></div>
                </div>
              ))}
              <div class="turn-left"></div>
            </div>

            <!-- BARIS 3: Kiri ke Kanan -->
            <div class="snake-row row-3">
              <div class="snake-line horizontal-line"></div>
              {row3.map((item) => (
                <div class="snake-node">
                  <div class="node-content text-top">
                    <span class="node-step">{item.step}</span>
                    <h4 class="node-title">{item.title}</h4>
                    <span class="node-date">{item.date}</span>
                  </div>
                  <div class="node-dot"></div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>

      <!-- ==========================================
           BAGIAN 7: DOKUMENTASI (10 FOTO BERBEDA)
           ========================================== -->
      <section class="section-gallery-marquee">
        <div class="site-container">
          <div class="section-badge-center">
            <h2 class="section-heading-single">
              Dokumentasi Kegiatan
            </h2>
            <p class="section-desc-center">
              Rekam jejak antusiasme, kebersamaan, dan euforia acara di setiap perjalanannya.
            </p>
          </div>
        </div>

        <div class="infinite-scroll-wrapper" id="scroll-gallery" data-speed="1.1">
          <div class="infinite-scroll-track">
            {docPhotos.map((photo, idx) => (
              <div class="gallery-item-card">
                <Image src={photo} alt={`Dokumentasi UNIX ${idx + 1}`} class="gallery-img-marquee" />
              </div>
            ))}
          </div>
        </div>
      </section>
    </main>

    <!-- ==========================================
         MODAL POPUP TESTIMONI
         ========================================== -->
    <div class="video-modal-backdrop" id="video-modal" aria-hidden="true">
      <div class="video-modal-dialog">
        <button type="button" class="video-modal-close" id="modal-close-btn" aria-label="Tutup Video">&times;</button>
        <div class="video-modal-body">
          <div class="video-player-wrapper" id="video-player-container"></div>
          <div class="video-modal-footer">
            <h3 class="modal-speaker-name" id="modal-name">Coming Soon</h3>
            <p class="modal-speaker-campus" id="modal-campus">Universitas</p>
          </div>
        </div>
      </div>
    </div>

    <!-- ==========================================
         MODAL POPUP NOTIFIKASI FITUR BELUM BISA DIAKSES
         ========================================== -->
    <div class="alert-modal-backdrop" id="alert-modal" aria-hidden="true">
      <div class="alert-modal-card">
        <div class="alert-icon-box">🔒</div>
        <h3 class="alert-modal-title" id="alert-title">Maaf, Belum Bisa Diakses</h3>
        <p class="alert-modal-desc" id="alert-desc">
          Fitur ini sedang dalam tahap pengembangan dan akan segera dibuka untuk Sobat UNIX.
        </p>
        <button type="button" class="btn btn-yellow alert-confirm-btn" id="alert-confirm-btn">
          Mengerti
        </button>
      </div>
    </div>

    <Footer />
  </body>
</html>

<script>
  // ==========================================
  // LOGIK MODAL VIDEO TESTIMONI
  // ==========================================
  const modal = document.getElementById('video-modal');
  const modalCloseBtn = document.getElementById('modal-close-btn');
  const videoPlayerContainer = document.getElementById('video-player-container');
  const modalName = document.getElementById('modal-name');
  const modalCampus = document.getElementById('modal-campus');

  const triggers = document.querySelectorAll('.play-video-trigger');

  triggers.forEach((trigger) => {
    trigger.addEventListener('click', () => {
      const name = trigger.getAttribute('data-name') || 'Coming Soon';
      const campus = trigger.getAttribute('data-campus') || '';

      if (modalName) modalName.textContent = name;
      if (modalCampus) modalCampus.textContent = campus;

      if (videoPlayerContainer) {
        videoPlayerContainer.innerHTML = `
          <div class="modal-no-video">
            <span style="font-size: 3.5rem;">🎬</span>
            <h3 style="margin: 1rem 0 0.3rem 0; color: #ffffff; font-size: 1.3rem;">Segera Tayang</h3>
            <p style="margin: 0; color: #94a3b8; font-size: 0.95rem;">Video testimoni dokumentasi ini sedang dalam proses kurasi & editing.</p>
          </div>
        `;
      }

      modal?.classList.add('active');
    });
  });

  function closeModal() {
    modal?.classList.remove('active');
    if (videoPlayerContainer) videoPlayerContainer.innerHTML = '';
  }

  modalCloseBtn?.addEventListener('click', closeModal);
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });

  // ==========================================
  // LOGIK POPUP FITUR TERKUNCI (INFORMASI & TAKITA)
  // ==========================================
  const alertModal = document.getElementById('alert-modal');
  const alertConfirmBtn = document.getElementById('alert-confirm-btn');
  const alertTitle = document.getElementById('alert-title');
  const lockedButtons = document.querySelectorAll('.locked-feature-btn');

  lockedButtons.forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      const feature = btn.getAttribute('data-feature-title') || 'Menu';
      if (alertTitle) {
        alertTitle.textContent = `${feature}: Belum Bisa Diakses`;
      }
      alertModal?.classList.add('active');
    });
  });

  const closeAlertModal = () => {
    alertModal?.classList.remove('active');
  };

  alertConfirmBtn?.addEventListener('click', closeAlertModal);
  alertModal?.addEventListener('click', (e) => {
    if (e.target === alertModal) closeAlertModal();
  });

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      if (modal?.classList.contains('active')) closeModal();
      if (alertModal?.classList.contains('active')) closeAlertModal();
    }
  });

  // ==========================================
  // HYBRID ENGINE: INFINITE SCROLL & TOUCH/DRAG
  // ==========================================
  const setupInfiniteSwipeTrack = (wrapperId: string) => {
    const wrapper = document.getElementById(wrapperId);
    if (!wrapper) return;

    const track = wrapper.querySelector('.infinite-scroll-track') as HTMLElement;
    if (!track) return;

    // Kloning isi track untuk looping mulus
    const initialCards = Array.from(track.children);
    initialCards.forEach((card) => {
      track.appendChild(card.cloneNode(true));
    });

    const speed = parseFloat(wrapper.dataset.speed || '1.0');
    let offset = 0;
    let isDown = false;
    let startX = 0;
    let lastX = 0;
    let velocity = 0;

    const update = () => {
      const halfWidth = track.scrollWidth / 2;

      if (!isDown) {
        velocity *= 0.95;
        offset -= speed + velocity;
      }

      if (offset <= -halfWidth) {
        offset += halfWidth;
      } else if (offset > 0) {
        offset -= halfWidth;
      }

      track.style.transform = `translate3d(${offset}px, 0, 0)`;
      requestAnimationFrame(update);
    };

    const onStart = (clientX: number) => {
      isDown = true;
      startX = clientX;
      lastX = clientX;
      velocity = 0;
      wrapper.classList.add('is-dragging');
    };

    const onMove = (clientX: number) => {
      if (!isDown) return;
      const delta = clientX - lastX;
      lastX = clientX;
      offset += delta;
      velocity = delta * 0.8;
    };

    const onEnd = () => {
      if (!isDown) return;
      isDown = false;
      wrapper.classList.remove('is-dragging');
    };

    wrapper.addEventListener('mousedown', (e) => onStart(e.clientX));
    window.addEventListener('mousemove', (e) => onMove(e.clientX));
    window.addEventListener('mouseup', onEnd);

    wrapper.addEventListener('touchstart', (e) => onStart(e.touches[0].clientX), { passive: true });
    window.addEventListener('touchmove', (e) => {
      if (isDown) onMove(e.touches[0].clientX);
    }, { passive: true });
    window.addEventListener('touchend', onEnd);

    requestAnimationFrame(update);
  };

  setupInfiniteSwipeTrack('scroll-testimonials');
  setupInfiniteSwipeTrack('scroll-videos');
  setupInfiniteSwipeTrack('scroll-gallery');
</script>

