---
import BaseHead from '../components/BaseHead.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="id">
  <head>
    <BaseHead 
      title={`Masuk - ${SITE_TITLE}`} 
      description={SITE_DESCRIPTION} 
    />
  </head>
  <body class="auth-body">
    <main class="auth-container">
      <div class="auth-card">
        <div class="auth-header">
          <h1 class="auth-title">
            Selamat Datang <span class="highlight-brand">SobatKita</span>
          </h1>
          <p class="auth-subtitle">Masuk untuk mengeksplor lebih banyak</p>
        </div>

        <form class="auth-form" id="login-form">
          <!-- Input Email / Username -->
          <div class="input-group" id="group-identifier">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="input-icon">
              <rect width="20" height="16" x="2" y="4" rx="2"></rect>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
            </svg>
            <input 
              type="text" 
              id="login-identifier" 
              placeholder="Email Kamu atau Username Akun" 
              class="form-control" 
              required 
            />
          </div>

          <!-- Input Password -->
          <div class="password-field-container">
            <div class="input-group" id="group-password">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="input-icon">
                <rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
              </svg>
              <input 
                type="password" 
                id="login-password" 
                placeholder="Password Kamu" 
                class="form-control" 
                required 
              />
              <button type="button" class="btn-toggle-eye" id="toggle-pwd-btn" aria-label="Lihat Password">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="eye-icon">
                  <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path>
                  <circle cx="12" cy="12" r="3"></circle>
                </svg>
              </button>
            </div>
            <!-- Pesan Error Dinamis Tepat di Bawah Kolom Password -->
            <div class="auth-error-msg hidden" id="login-error-text">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="error-inline-icon">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
              </svg>
              <span>Akun atau password salah</span>
            </div>
          </div>

          <!-- Link Lupa Password -->
          <div class="auth-meta-row">
            <a href="#" class="forgot-link" id="btn-open-forgot-modal">Lupa Password?</a>
          </div>

          <button type="submit" class="btn-primary-action">
            Masuk
          </button>
        </form>

        <p class="auth-switch-text">
          Belum punya akun? <a href="/daftar" class="auth-switch-link">Daftar sekarang</a>
        </p>
      </div>
    </main>

    <!-- Modal Pop-up Lupa Password -->
    <div class="modal-backdrop-clean hidden" id="forgot-modal">
      <div class="modal-dialog-forgot">
        <div class="modal-icon-badge">⏳</div>
        <h3 class="modal-forgot-title">Permintaan Reset Sandi</h3>
        <p class="modal-forgot-desc">
          Mohon menunggu proses verifikasi dan perubahan kata sandi maksimal <strong>2x24 jam</strong> kerja oleh tim Admin TemanKita.
        </p>
        <p class="modal-forgot-instruction">
          Tekan tombol di bawah untuk mengisi format konfirmasi melalui WhatsApp Admin:
        </p>

        <div class="modal-forgot-actions">
          <button type="button" class="btn-modal-back" id="btn-close-forgot-modal">
            Batal
          </button>
          <button type="button" class="btn-modal-proceed-wa" id="btn-proceed-forgot-wa">
            Lanjut Lupa Sandi &rarr;
          </button>
        </div>
      </div>
    </div>
  </body>
</html>

<script>
  // Toggle Eye Password
  const toggleBtn = document.getElementById('toggle-pwd-btn');
  const pwdInput = document.getElementById('login-password') as HTMLInputElement;
  const identifierInput = document.getElementById('login-identifier') as HTMLInputElement;
  const errorTextEl = document.getElementById('login-error-text');

  toggleBtn?.addEventListener('click', () => {
    pwdInput.type = pwdInput.type === 'password' ? 'text' : 'password';
  });

  // Hapus pesan error saat pengguna mulai mengetik ulang
  const clearError = () => {
    if (errorTextEl && !errorTextEl.classList.contains('hidden')) {
      errorTextEl.classList.add('hidden');
      pwdInput.classList.remove('input-has-error');
      identifierInput.classList.remove('input-has-error');
    }
  };

  pwdInput?.addEventListener('input', clearError);
  identifierInput?.addEventListener('input', clearError);

  // Trigger error: tampilkan teks error di bawah password & reset input password
  const triggerAuthError = () => {
    if (errorTextEl) {
      errorTextEl.classList.remove('hidden');
    }
    pwdInput.classList.add('input-has-error');
    identifierInput.classList.add('input-has-error');
    pwdInput.value = ''; // Reset isi password
    pwdInput.focus();   // Fokuskan kembali ke kolom password
  };

  // Modal Lupa Password
  const openForgotBtn = document.getElementById('btn-open-forgot-modal');
  const forgotModal = document.getElementById('forgot-modal');
  const closeForgotBtn = document.getElementById('btn-close-forgot-modal');
  const proceedForgotBtn = document.getElementById('btn-proceed-forgot-wa');

  openForgotBtn?.addEventListener('click', (e) => {
    e.preventDefault();
    forgotModal?.classList.remove('hidden');
  });

  closeForgotBtn?.addEventListener('click', () => {
    forgotModal?.classList.add('hidden');
  });

  proceedForgotBtn?.addEventListener('click', () => {
    const defaultEmail = identifierInput?.value.trim() || '[Isi Gmail Terdaftar]';
    const waNumber = '62895704906969';
    const waMessage = 
`Halo Admin TemanKita UNIX 2027, Saya ingin merubah sandi akun saya.

Berikut data akun saya:
- Gmail Terdaftar: ${defaultEmail}
- Sandi Lama (seingatnya): [Isi sandi lama seingatnya]
- Sandi Baru yang Diinginkan: [Isi sandi baru minimal 8 karakter]

Mohon bantuannya untuk diproses dalam 2x24 jam. Terima kasih!`;

    const waUrl = `https://wa.me/${waNumber}?text=${encodeURIComponent(waMessage)}`;
    forgotModal?.classList.add('hidden');
    window.open(waUrl, '_blank');
  });

  // Database Akun Administrator
  const ADMIN_CREDENTIALS: Record<string, { pass: string; role: string; name: string }> = {
    'Admin_TKUNIX27': { pass: 'unixgaspol1701._', role: 'admin_TKUNIX27', name: 'Admin TKUNIX27' },
    'Admin_Sponsorship': { pass: 'unixgaspol1701._', role: 'admin_Sponsorship', name: 'Admin Sponsorship' },
    'Admin_Ticketing': { pass: 'unixgaspol1701._', role: 'admin_Ticketing', name: 'Admin Ticketing' },
  };

  const loginForm = document.getElementById('login-form');
  loginForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    const identifier = identifierInput.value.trim();
    const password = pwdInput.value;

    // 1. Cek Akun Admin Resmi
    if (ADMIN_CREDENTIALS[identifier]) {
      const admin = ADMIN_CREDENTIALS[identifier];
      if (admin.pass === password) {
        localStorage.setItem('unix_logged_in_user', admin.role);
        localStorage.setItem('unix_user_name', admin.name);
        localStorage.setItem('unix_user_email', `${identifier.toLowerCase()}@unix.temankita.org`);
        window.location.href = '/';
        return;
      } else {
        triggerAuthError();
        return;
      }
    }

    // 2. Cek Akun Pengguna Terdaftar
    const registeredUsers = JSON.parse(localStorage.getItem('unix_registered_users') || '[]');
    const user = registeredUsers.find(
      (u: any) => u.email.toLowerCase() === identifier.toLowerCase() || u.fullName.toLowerCase() === identifier.toLowerCase()
    );

    if (user) {
      if (user.password === password) {
        localStorage.setItem('unix_logged_in_user', 'user_member');
        localStorage.setItem('unix_user_name', user.fullName);
        localStorage.setItem('unix_user_email', user.email);
        localStorage.setItem('unix_user_phone', user.phone);
        window.location.href = '/';
      } else {
        triggerAuthError();
      }
    } else {
      triggerAuthError();
    }
  });
</script>

<style>
  .auth-body {
    margin: 0;
    padding: 0;
    min-height: 100vh;
    background-image: url('../assets/background.png');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    font-family: inherit;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .auth-container {
    width: 100%;
    max-width: 450px;
    padding: 1.5rem;
    box-sizing: border-box;
  }

  .auth-card {
    background: #ffffff;
    border-radius: 24px;
    padding: clamp(2rem, 4vw, 2.8rem);
    box-shadow: 0 25px 60px -15px rgba(0, 0, 0, 0.35);
  }

  .auth-header {
    text-align: center;
    margin-bottom: 2rem;
  }

  .auth-title {
    font-size: 1.6rem;
    font-weight: 800;
    color: #1e293b;
    margin: 0 0 0.4rem 0;
  }

  .highlight-brand {
    color: #f59e0b;
  }

  .auth-subtitle {
    font-size: 0.9rem;
    color: #64748b;
    margin: 0;
  }

  .auth-form {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .password-field-container {
    display: flex;
    flex-direction: column;
  }

  .input-group {
    position: relative;
    display: flex;
    align-items: center;
  }

  .input-icon {
    position: absolute;
    left: 1rem;
    width: 19px;
    height: 19px;
    color: #94a3b8;
  }

  .form-control {
    width: 100%;
    padding: 0.85rem 1rem 0.85rem 2.8rem;
    border: 1.5px solid #e2e8f0;
    border-radius: 12px;
    font-size: 0.92rem;
    font-family: inherit;
    outline: none;
    box-sizing: border-box;
    transition: all 0.2s ease;
  }

  .form-control:focus {
    border-color: #f59e0b;
    box-shadow: 0 0 0 3px rgba(245, 158, 11, 0.15);
  }

  /* Style Border Merah Saat Error */
  .form-control.input-has-error {
    border-color: #ef4444 !important;
    background-color: #fef2f2 !important;
  }

  .form-control.input-has-error:focus {
    box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.15) !important;
  }

  /* Pesan Error Tepat di Bawah Kolom Password */
  .auth-error-msg {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: #ef4444;
    font-size: 0.82rem;
    font-weight: 700;
    margin-top: 0.45rem;
    padding-left: 0.25rem;
    animation: fadeInSlide 0.2s ease-out;
  }

  @keyframes fadeInSlide {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .error-inline-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }

  .btn-toggle-eye {
    position: absolute;
    right: 0.85rem;
    background: none;
    border: none;
    cursor: pointer;
    color: #94a3b8;
    display: flex;
    align-items: center;
  }

  .eye-icon {
    width: 20px;
    height: 20px;
  }

  .auth-meta-row {
    display: flex;
    justify-content: flex-end;
  }

  .forgot-link {
    font-size: 0.8rem;
    font-weight: 600;
    color: #64748b;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .forgot-link:hover {
    color: #f59e0b;
    text-decoration: underline;
  }

  .btn-primary-action {
    width: 100%;
    padding: 0.85rem;
    background-color: #f59e0b;
    color: #ffffff;
    border: none;
    border-radius: 12px;
    font-size: 1rem;
    font-weight: 800;
    cursor: pointer;
    box-shadow: 0 4px 14px rgba(245, 158, 11, 0.35);
    transition: all 0.2s ease;
  }

  .btn-primary-action:hover {
    background-color: #d97706;
    transform: translateY(-1px);
  }

  .auth-switch-text {
    text-align: center;
    font-size: 0.85rem;
    color: #64748b;
    margin: 1.6rem 0 0 0;
  }

  .auth-switch-link {
    color: #f59e0b;
    font-weight: 700;
    text-decoration: none;
  }

  .auth-switch-link:hover {
    text-decoration: underline;
  }

  /* MODAL POP-UP */
  .hidden {
    display: none !important;
  }

  .modal-backdrop-clean {
    position: fixed;
    inset: 0;
    background: rgba(15, 23, 42, 0.7);
    backdrop-filter: blur(5px);
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    box-sizing: border-box;
  }

  .modal-dialog-forgot {
    background: #ffffff;
    border-radius: 20px;
    padding: 2.2rem 1.8rem;
    width: 100%;
    max-width: 420px;
    text-align: center;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.3);
    box-sizing: border-box;
  }

  .modal-icon-badge {
    font-size: 2.6rem;
    margin-bottom: 0.6rem;
  }

  .modal-forgot-title {
    font-size: 1.3rem;
    font-weight: 900;
    color: #12055f;
    margin: 0 0 0.5rem 0;
  }

  .modal-forgot-desc {
    font-size: 0.9rem;
    color: #475569;
    line-height: 1.55;
    margin: 0 0 0.8rem 0;
  }

  .modal-forgot-desc strong {
    color: #b45309;
  }

  .modal-forgot-instruction {
    font-size: 0.82rem;
    color: #64748b;
    line-height: 1.5;
    margin: 0 0 1.6rem 0;
  }

  .modal-forgot-actions {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
  }

  .btn-modal-back {
    flex: 1;
    padding: 0.75rem 1rem;
    background-color: #f1f5f9;
    color: #475569;
    border: 1px solid #cbd5e1;
    border-radius: 10px;
    font-size: 0.9rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .btn-modal-back:hover {
    background-color: #e2e8f0;
  }

  .btn-modal-proceed-wa {
    flex: 1.4;
    padding: 0.75rem 1rem;
    background-color: #25d366;
    color: #ffffff;
    border: none;
    border-radius: 10px;
    font-size: 0.9rem;
    font-weight: 800;
    cursor: pointer;
    box-shadow: 0 4px 12px rgba(37, 211, 102, 0.35);
    transition: all 0.2s ease;
  }

  .btn-modal-proceed-wa:hover {
    background-color: #1eb956;
    transform: translateY(-1px);
    box-shadow: 0 6px 16px rgba(37, 211, 102, 0.45);
  }
</style>